# Copy to .env and fill in your local values. .env is git-ignored.
DB_URL=jdbc:postgresql://localhost:5432/library_db
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

# Security (Phase 10). JWT_SECRET and ADMIN_PASSWORD are required: the app will not start without them.
# JWT_SECRET: Base64 of >= 32 random bytes, e.g. `openssl rand -base64 32`
JWT_SECRET=
# ADMIN_PASSWORD: >= 8 chars with upper, lower, digit and special character
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
CORS_ALLOWED_ORIGIN=http://localhost:3000
